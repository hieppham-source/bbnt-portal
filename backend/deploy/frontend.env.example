# =============================================================================
# BBNT Frontend (Next.js + Auth.js v5) — Cloudflare Workers > Settings > Variables and Secrets (type "Secret"),
# hoặc `npx wrangler secret put <KEY>`.
# =============================================================================
AUTH_SECRET=                         # chuỗi ngẫu nhiên 32+ byte:  openssl rand -base64 32
AUTH_URL=https://bbnt-portal-frontend.<account>.workers.dev  # hoặc domain riêng
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=1234567890-xxxxxxxx.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=GOCSPX-xxxxxxxxxxxxxxxx   # CHỈ ở frontend, không bao giờ đưa vào biến NEXT_PUBLIC_*
ALLOWED_EMAIL_DOMAIN=hannaholala.com
# NEXT_PUBLIC_* được Next.js nhúng thẳng vào code LÚC BUILD (không phải lúc chạy) — trên Cloudflare Workers Builds
# phải set ở mục "Build variables and secrets" (Settings > Build), KHÔNG phải "Variables and Secrets" (runtime).
NEXT_PUBLIC_API_BASE_URL=https://bbnt-api.onrender.com   # URL backend Render, không có / cuối
