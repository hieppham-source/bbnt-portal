# =============================================================================
# BBNT Backend (FastAPI) — biến môi trường. Trên Render nhập ở tab Environment (hoặc khi tạo Blueprint).
# KHÔNG commit file .env thật lên GitHub. Tool không có database, không lưu file BBNT.
# =============================================================================

# --- Môi trường -----------------------------------------------------------------
APP_ENV=production                      # production | staging | development
APP_TIMEZONE=Asia/Ho_Chi_Minh           # bắt buộc đúng giá trị này (số BBNT đánh theo giờ VN)
TZ=Asia/Ho_Chi_Minh                     # giờ của log trong container

# --- Sheet master (hợp đồng, brand, pháp nhân, mapping) ----------------------------
# Tạo từ deploy/MASTER_BBNT_TEMPLATE.xlsx (Google Drive > Tải lên > Mở bằng Google Trang tính),
# share quyền Người xem cho những người dùng tool (hoặc cả domain hannaholala.com).
MASTER_SHEET_URL=https://docs.google.com/spreadsheets/d/<MASTER_SHEET_ID>/edit
MASTER_CACHE_SECONDS=60                 # sửa Sheet master -> tool thấy sau tối đa N giây (hoặc bấm "Tải lại master")
# MASTER_FILE=deploy/MASTER_BBNT_TEMPLATE.xlsx   # CHỈ chạy local không có Google: đọc master từ file .xlsx
# TEMPLATES_DIR=./templates                      # mặc định thư mục templates/ trong repo

# --- Đăng nhập (Google OAuth) ----------------------------------------------------
# Client ID của OAuth client "Web application" (giống AUTH_GOOGLE_ID bên frontend). Backend KHÔNG cần secret.
GOOGLE_OAUTH_CLIENT_ID=1234567890-xxxxxxxx.apps.googleusercontent.com
ALLOWED_EMAIL_DOMAINS=hannaholala.com
ALLOWED_EMAILS=                         # ngoại lệ ngoài domain, phân cách dấu phẩy (thường để trống)
DEV_AUTH_HEADER=false                   # luôn false ở production

# --- CORS ------------------------------------------------------------------------
# Domain frontend chính xác, https, không có dấu / ở cuối. Nhiều domain: phân cách dấu phẩy.
CORS_ALLOWED_ORIGINS=https://bbnt-portal.netlify.app
CORS_ALLOWED_ORIGIN_REGEX=              # vd ^https://deploy-preview-\d+--bbnt-portal\.netlify\.app$

# --- Đọc Google Sheet --------------------------------------------------------------
# KHÔNG dùng service account. Frontend xin scope spreadsheets.readonly khi đăng nhập Google và gửi
# access token kèm mỗi request (header X-Google-Access-Token). Backend kiểm token qua Google tokeninfo
# (đúng app GOOGLE_OAUTH_CLIENT_ID, đúng người, đúng scope) rồi gọi Sheets API bằng quyền của người đó.
# -> Không có biến nào cần đặt ở mục này.

# --- Server ------------------------------------------------------------------------
# PORT do Render tự cấp — không cần đặt.
WEB_CONCURRENCY=1                       # Render Free chỉ có 512 MB RAM -> 1 process
