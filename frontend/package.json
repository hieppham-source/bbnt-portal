    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "next": "15.5.28",
    "next-auth": "5.0.0-beta.32",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.12",
    "@types/node": "22.15.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "typescript": "5.9.3",
    "wrangler": "4.151.2"
  },
  "engines": {
    "node": ">=20"
  }
}
