{
  "name": "bbnt-portal-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
