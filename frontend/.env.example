# Netlify > Site configuration > Environment variables (local: copy thành .env.local)
AUTH_SECRET=                                   # openssl rand -base64 32
AUTH_URL=https://bbnt.hannaholala.com          # local: http://localhost:3000
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=1234567890-xxxxxxxx.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=GOCSPX-xxxxxxxxxxxxxxxx     # chỉ ở frontend, KHÔNG đặt trong biến NEXT_PUBLIC_*
ALLOWED_EMAIL_DOMAIN=hannaholala.com
NEXT_PUBLIC_API_BASE_URL=https://api-bbnt.hannaholala.com   # local: http://localhost:8000, không có / cuối
